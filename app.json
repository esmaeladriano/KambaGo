{
  "expo": {
    "name": "KambaGo",
    "slug": "kambago",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kambago",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#FFFFFF",
    "primaryColor": "#E53935",
    "android": {
      "package": "ao.kambago.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#E53935"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O KambaGo usa a tua localização apenas enquanto a aplicação está aberta para encontrar rotas próximas."
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 240
        }
      ]
    ],
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png",
      "bundler": "metro"
    }
  }
}
