# ==============================================================================
# KambaGo - Variáveis de Ambiente (.env.example)
# Nunca inserir chaves privadas reais neste ficheiro nem no código cliente.
# ==============================================================================

# --- Cliente Expo (apenas chaves públicas) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Provedor de mapas atrás da camada de abstração ("google" | "mapbox")
EXPO_PUBLIC_MAPS_PROVIDER=google
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=

# ID do projeto EAS / Expo para notificações push (deixar vazio até configurar Expo Notifications)
EXPO_PUBLIC_EXPO_PROJECT_ID=

# Ambiente da aplicação ("development" | "staging" | "production")
EXPO_PUBLIC_APP_ENV=development

# --- Servidor / Scripts administrativos (NUNCA expor no cliente) ---
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: URL da aplicação no ambiente de alojamento
APP_URL=
